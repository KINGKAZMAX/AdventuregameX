# --- dependencies (reinstall with `npm install`) ---
node_modules/

# --- build output (regenerate with `npm run build`) ---
/dist/
apps/*/dist/
# The hub's /public is populated from the child app builds by
# scripts/prepare-apps.mjs — it is generated, not source.
/public/

# --- logs & OS/editor cruft ---
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- local agent / tooling state (not part of the project) ---
.claude/
.superpowers/
docs/superpowers/
